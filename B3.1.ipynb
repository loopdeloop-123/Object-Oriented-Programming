class Summon:
    total_created = 0
    active_count = 0
    total_power = 0

    def __init__(self, name="Fire Sprite", power=50):
        self._name = name
        self._power = power
        self._active = True

        Summon.total_created += 1
        Summon.active_count += 1
        Summon.total_power += power

    def get_name(self):
        return self._name

    def get_power(self):
        return self._power

    def is_active(self):
        return self._active

    def set_name(self, name):
        if name == "":
            print("[ERROR] Name cannot be empty.")
        else:
            self._name = name

    def set_power(self, power):
        if power <= 0:
            print("[ERROR] Power must be greater than 0.")
        else:
            Summon.total_power -= self._power
            Summon.total_power += power
            self._power = power

    def upgrade(self, amount):
        self.set_power(self._power + amount)

    def deactivate(self):
        if not self._active:
            print(f"[WARN] {self._name} is already inactive.")
            return

        self._active = False
        Summon.active_count -= 1
        Summon.total_power -= self._power

        print(f"[SYSTEM] {self._name} has been deactivated.")

    def display(self):
        print(
            f"Name: {self._name} | Power: {self._power} | Active: {self._active}"
        )

    @classmethod
    def display_global_stats(cls):
        print(
            f"Global State -> Total Created: {cls.total_created} | "
            f"Active Count: {cls.active_count} | "
            f"Total Power: {cls.total_power}"
        )


print("=== GAME ENTITY ENGINE TEST SUITE ===\n")

print("--- Phase 1: Multi-Instance Instantiation ---")

s1 = Summon()
s2 = Summon("Ice Golem", 120)
s3 = Summon("Storm Dragon", 200)

s1.display()
s2.display()
s3.display()

Summon.display_global_stats()

print("\n--- Phase 2: Mutator Bounds Validation ---")

s1.set_power(-10)
s2.set_name("")

print("\n--- Phase 3: State Transformation ---")

print("Upgrading Ice Golem by 30 power...")
s2.upgrade(30)

s2.display()
Summon.display_global_stats()

print("\n--- Phase 4: Lifecycle Transformation ---")

s3.deactivate()

Summon.display_global_stats()

print("\n--- Phase 5: Redundant Safeguards ---")

s3.deactivate()

Summon.display_global_stats()

print("\n=== TEST SUITE COMPLETE ===")
